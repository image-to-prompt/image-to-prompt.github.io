# Image to Prompt API - Environment Variables

# Server Configuration
PORT=3000

# CORS (set to your GitHub Pages domain in production)
# Example: https://yourusername.github.io
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT=3
RATE_LIMIT_WINDOW=86400

# OpenAI Configuration
OPENAI_API_KEY=sk-your-api-key-here
# Optional: Custom OpenAI-compatible endpoint (e.g., OpenRouter, Together AI)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Model Configuration
# Options: gpt-4o, gpt-4o-mini, gpt-4-turbo
MODEL=gpt-4o-mini
